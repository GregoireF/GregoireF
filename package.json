{
  "name": "gregoiref-profile",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Generator for the GregoireF GitHub profile: README and light/dark SVG cards.",
  "scripts": {
    "build": "bun src/cli.ts build",
    "preview": "bun src/cli.ts build --open",
    "readme": "bun src/cli.ts readme",
    "cards": "bun src/cli.ts cards",
    "sync": "bun src/cli.ts sync",
    "check": "biome check . && tsc --noEmit && knip && bun test && bun src/cli.ts readme --check",
    "fix": "biome check --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "@types/fontkit": "^2.0.9",
    "fontkit": "^3.0.0",
    "geist": "^1.9.2",
    "knip": "^6.47.0",
    "simple-icons": "^16.38.0",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2"
  }
}
